# CLMU-LCZ container environment
# The dependency versions below follow the CIME Docker recipe shipped with
# the ctsm5.1.dev166-LCZ source, with the versions recorded in its README.
FROM condaforge/miniforge3:latest

ARG TARGETARCH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV USER=root \
    LOGNAME=root \
    CIME_MODEL=cesm \
    PROJECT=/p/project \
    SCRATCH=/p/scratch \
    CESMDATAROOT=/p/scratch/CESMDATAROOT \
    CSMDATA=/p/scratch/CESMDATAROOT/inputdata \
    CASESCRIPT=/p/project/ctsm5.1.dev166-LCZ/cime/scripts \
    ESMFMKFILE=/opt/clmu/lib/esmf.mk \
    PATH=/opt/clmu/bin:/opt/conda/bin:/usr/bin:/bin

# CIME's Python tools and system Perl modules, including XML::LibXML and Switch.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates git perl libxml-libxml-perl libswitch-perl \
        curl wget m4 make subversion \
    && rm -rf /var/lib/apt/lists/*

# CIME/CTSM build tools and the compatible GNU, MPI, NetCDF and ESMF stack.
# ESMF 8.6.1 is used on amd64. conda-forge's last ESMF build for Linux ARM64
# is 8.4.2, which meets this CIME branch's documented minimum (8.4.1).
# Keep Python on 3.10 and use native compilers for the target architecture.
RUN set -euo pipefail; \
    case "${TARGETARCH}" in \
        amd64) \
            ESMF_VERSION=8.6.1; \
            OPENMPI_VERSION=5.0.8; \
            COMPILER_PACKAGES=(gcc_linux-64=12.4.0 gxx_linux-64=12.4.0 gfortran_linux-64=12.4.0); \
            COMPILER_PREFIX=x86_64-conda-linux-gnu ;; \
        arm64) \
            ESMF_VERSION=8.4.2; \
            OPENMPI_VERSION=4.1.6; \
            COMPILER_PACKAGES=(gcc_linux-aarch64=12.4.0 gxx_linux-aarch64=12.4.0 gfortran_linux-aarch64=12.4.0); \
            COMPILER_PREFIX=aarch64-conda-linux-gnu ;; \
        *) echo "Unsupported target architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    mamba create --yes --prefix /opt/clmu --channel conda-forge \
        python=3.10.22 \
        cmake make curl wget subversion m4 pyyaml pytest \
        blas lapack \
        libnetcdf=4.9.2=*openmpi* \
        netcdf-fortran=4.6.1=*openmpi* \
        "esmf=${ESMF_VERSION}=*openmpi*" \
        "${COMPILER_PACKAGES[@]}" \
        gcc=12.4.0 gxx=12.4.0 gfortran=12.4.0 \
        "openmpi=${OPENMPI_VERSION}" openmpi-mpifort \
    && ln -sf "/opt/clmu/bin/${COMPILER_PREFIX}-ar" /opt/clmu/bin/ar \
    && ln -sf "/opt/clmu/bin/${COMPILER_PREFIX}-ranlib" /opt/clmu/bin/ranlib \
    && mamba clean --all --yes

# PnetCDF is built against the same OpenMPI and NetCDF installation.
ARG PNETCDF_VERSION=1.12.3
RUN set -euo pipefail; \
    if [[ "${TARGETARCH}" == "arm64" ]]; then \
        PNETCDF_SHARED_FLAG=--disable-shared; \
    else \
        PNETCDF_SHARED_FLAG=--enable-shared; \
    fi; \
    curl -L --fail --retry 3 \
        "https://parallel-netcdf.github.io/Release/pnetcdf-${PNETCDF_VERSION}.tar.gz" \
        -o /tmp/pnetcdf.tar.gz \
    && mkdir /tmp/pnetcdf \
    && tar -xzf /tmp/pnetcdf.tar.gz -C /tmp/pnetcdf --strip-components=1 \
    && cd /tmp/pnetcdf \
    && ./configure --prefix=/opt/clmu --disable-cxx "${PNETCDF_SHARED_FLAG}" \
        MPICC=/opt/clmu/bin/mpicc MPICXX=/opt/clmu/bin/mpicxx \
        MPIF77=/opt/clmu/bin/mpif77 MPIF90=/opt/clmu/bin/mpif90 \
    && make -j4 \
    && make install \
    && rm -rf /tmp/pnetcdf /tmp/pnetcdf.tar.gz

# PIO in this CTSM branch uses old CMake minimum-version declarations.
# CMake 4 rejects them, so keep the build tool on a compatible 3.x release.
RUN mamba install --yes --prefix /opt/clmu --channel conda-forge cmake=3.31.6 \
    && mamba clean --all --yes

# CIME reads machine/compiler settings from this directory.
COPY dockerfile/cime_config/ /root/.cime/

# CIME build-namelist uses Perl modules installed from the Linux distribution.
RUN ln -sf /usr/bin/perl /opt/clmu/bin/perl \
    && perl -MXML::LibXML -MSwitch -e 'print "CIME Perl modules available\n"'

# Obtain the LCZ model and the external source repositories pinned by its
# Externals.cfg files. CLM is this repository itself, so CIME must use SRCROOT.
RUN mkdir -p /p/project /p/scratch/CESMDATAROOT/inputdata \
        /p/scratch/CESMDATAROOT/inputdata/atm/datm7 \
        /p/scratch/CESMDATAROOT/CaseOutputs /p/scratch/CESMDATAROOT/Archive \
        /p/scratch/CESMDATAROOT/BaselineTests /p/pyscripts \
    && git clone --branch ctsm5.1.dev166-LCZ --single-branch \
        https://github.com/YuanSun-UoM/esm-dev_code.git \
        /p/project/ctsm5.1.dev166-LCZ \
    && cd /p/project/ctsm5.1.dev166-LCZ \
    && ./manage_externals/checkout_externals \
    && sed -E -i '/<entry id="COMP_ROOT_DIR_LND">/,/<\/entry>/ s#(<value component="clm"[[:space:]]*>)[^<]*(</value>)#\1$SRCROOT/\2#' \
        cime/CIME/data/config/cesm/config_files.xml \
    && sed -n '/<entry id="COMP_ROOT_DIR_LND">/,/<\/entry>/p' \
        cime/CIME/data/config/cesm/config_files.xml | grep -Eq '<value component="clm"[[:space:]]*>\$SRCROOT/</value>' \
    && grep -Fq '<value component="clm">$COMP_ROOT_DIR_LND/cime_config/config_tests.xml</value>' \
        cime/CIME/data/config/cesm/config_files.xml

WORKDIR /root
CMD ["/bin/bash", "-l"]
